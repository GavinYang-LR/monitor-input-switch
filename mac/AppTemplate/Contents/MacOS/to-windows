#!/bin/zsh

set -u

readonly CLI="/opt/homebrew/bin/betterdisplaycli"

if [[ ! -x "${CLI}" ]]; then
  /usr/bin/osascript -e 'display alert "BetterDisplay is required" message "Install and start BetterDisplay before using this app." as critical'
  exit 1
fi

/usr/bin/open -gja BetterDisplay
/bin/sleep 1

if "${CLI}" set -feature=ddc -vcp=0x60 -value=0x10; then
  exit 0
fi

/usr/bin/osascript -e 'display alert "Switch failed" message "Confirm that Extra > DDC/CI is set to Yes on the monitor and that BetterDisplay is running." as critical'
exit 1
